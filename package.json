{
  "name": "stylelint-less-monorepo",
  "private": true,
  "scripts": {
    "format": "oxfmt",
    "knip": "knip",
    "prepare": "husky",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^24.10.4",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.72.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,json,md,mjs,ts,yml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=21"
  }
}
