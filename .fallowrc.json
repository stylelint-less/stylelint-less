{
  "$schema": "./node_modules/fallow/schema.json",
  "ignoreDependencies": [
    "@babel/preset-env",
    "stylelint-less",
    "stylelint-config-recommended-less"
  ],
  "ignoreExports": [
    {
      "file": "packages/stylelint-less/src/rules/**/index.js",
      "exports": ["messages", "ruleName"]
    },
    { "file": "packages/stylelint-less/src/utils/index.js", "exports": ["isLessVariable"] }
  ],
  "ignoreDependencyOverrides": [{ "package": "smol-toml" }]
}
